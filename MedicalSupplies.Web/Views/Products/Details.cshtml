@model ProductDetailsViewModel
@{ ViewData["Title"] = Model.ProductName; }

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Products</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-categoryId="">@Model.CategoryName</a></li>
        <li class="breadcrumb-item active">@Model.ProductName</li>
    </ol>
</nav>

<div class="row">
    <div class="col-md-5">
        @if (Model.ImageUrls.Any())
        {
            <img src="@Model.ImageUrls.First()" class="img-fluid rounded border" alt="@Model.ProductName" />
            @if (Model.ImageUrls.Count > 1)
            {
                <div class="d-flex gap-2 mt-2">
                    @foreach (var url in Model.ImageUrls.Skip(1))
                    {
                        <img src="@url" style="width:70px; height:70px; object-fit:cover;" class="rounded border" />
                    }
                </div>
            }
        }
        else
        {
            <img src="/images/placeholder-product.svg" class="img-fluid rounded border" alt="@Model.ProductName" />
        }
    </div>

    <div class="col-md-7">
        <h1>@Model.ProductName</h1>
        <p class="text-muted">
            Code: @Model.ProductCode ·
            @Model.CategoryName
            @if (Model.BrandName is not null) { <text> · @Model.BrandName</text> }
        </p>

        @if (Model.InStock)
        {
            <span class="badge bg-success mb-3">In Stock</span>
        }
        else
        {
            <span class="badge bg-secondary mb-3">Check Availability</span>
        }

        <h4 class="text-primary">Price: Request a Quote</h4>

        @if (Model.PackSize is not null) { <p><strong>Pack Size:</strong> @Model.PackSize</p> }
        @if (Model.UnitOfMeasure is not null) { <p><strong>Unit of Measure:</strong> @Model.UnitOfMeasure</p> }

        @if (Model.Description is not null)
        {
            <h5 class="mt-4">Description</h5>
            <p>@Model.Description</p>
        }

        @if (Model.Specifications is not null)
        {
            <h5 class="mt-4">Specifications</h5>
            <p style="white-space: pre-line;">@Model.Specifications</p>
        }

        <form asp-controller="Quotation" asp-action="Add" method="post" class="d-flex align-items-end gap-2 mt-4">
            <input type="hidden" name="productId" value="@Model.ProductId" />
            <input type="hidden" name="returnUrl" value="@Url.Action("Details", new { id = Model.ProductId })" />
            <div>
                <label class="form-label">Quantity</label>
                <input type="number" name="quantity" value="1" min="1" class="form-control" style="width:100px;" />
            </div>
            <button type="submit" class="btn btn-primary">Request Quotation</button>
        </form>
    </div>
</div>

@if (Model.RelatedProducts.Any())
{
    <h3 class="mt-5">Related Products</h3>
    <div class="row row-cols-1 row-cols-md-4 g-4">
        @foreach (var related in Model.RelatedProducts)
        {
            <div class="col">
                <div class="card h-100">
                    <a asp-action="Details" asp-route-id="@related.ProductId">
                        <img src="@(related.PrimaryImageUrl ?? "/images/placeholder-product.svg")"
                             class="card-img-top" style="height:140px; object-fit:cover;" />
                    </a>
                    <div class="card-body">
                        <h6 class="card-title">
                            <a asp-action="Details" asp-route-id="@related.ProductId" class="text-decoration-none text-dark">@related.ProductName</a>
                        </h6>
                    </div>
                </div>
            </div>
        }
    </div>
}
