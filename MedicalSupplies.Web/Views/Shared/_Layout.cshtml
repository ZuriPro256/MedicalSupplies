@using MedicalSupplies.Web.Services
@inject ICustomerNotificationService CustomerNotificationService
@{
    var customerUnreadCount = 0;
    if (User.Identity?.IsAuthenticated == true && User.IsInRole("Customer"))
    {
        customerUnreadCount = await CustomerNotificationService.GetUnreadCountAsync(User);
    }
}

@inject MedicalSupplies.Web.Services.IQuotationCartService QuotationCartService
@{
    var cartCount = QuotationCartService.GetCart(Context.Session).Count;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zuripro Medical Supplies</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm">
            <div class="container">
                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    Zuripro Medical Supplies
                </a>

                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Products"
                               asp-action="Index">
                                Products
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Quotation"
                               asp-action="Cart"
                               aria-label="Cart with @cartCount product items">
                                <i class="bi bi-cart3 me-1" aria-hidden="true"></i>Cart
                                @if (cartCount > 0)
                                {
                                    <span class="badge rounded-pill bg-danger ms-1">@cartCount</span>
                                }
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true &&
                             User.IsInRole("Customer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center gap-1"
                                   asp-controller="Account"
                                   asp-action="Updates">
                                    Updates

                                    @if (customerUnreadCount > 0)
                                    {
                                        <span class="badge rounded-pill bg-danger">
                                            @customerUnreadCount
                                        </span>
                                    }
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Contact"
                               asp-action="Index">
                                Contact Us
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- Logged-in identity -->
                            <li class="nav-item">
                                @await Component.InvokeAsync("LoggedInAs")
                            </li>

                            @if (User.IsInRole("SuperAdmin") ||
                                 User.IsInRole("Admin") ||
                                 User.IsInRole("Sales") ||
                                 User.IsInRole("InventoryManager"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-area="Admin"
                                       asp-controller="Dashboard"
                                       asp-action="Index">
                                        Admin Dashboard
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <form asp-controller="Account"
                                          asp-action="Logout"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="nav-link btn btn-link border-0">
                                            Logout
                                        </button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle"
                                       href="#"
                                       role="button"
                                       data-bs-toggle="dropdown">
                                        Business Account
                                    </a>

                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Account"
                                               asp-action="Dashboard">
                                                Dashboard
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Account"
                                               asp-action="Quotations">
                                                My Quotations
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Account"
                                               asp-action="Orders">
                                                My Orders
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item d-flex justify-content-between align-items-center"
                                               asp-controller="Account"
                                               asp-action="Updates">
                                                <span>Updates</span>

                                                @if (customerUnreadCount > 0)
                                                {
                                                    <span class="badge bg-danger rounded-pill">
                                                        @customerUnreadCount
                                                    </span>
                                                }
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Account"
                                               asp-action="Profile">
                                                Profile
                                            </a>
                                        </li>

                                        <li>
                                            <hr class="dropdown-divider" />
                                        </li>

                                        <li>
                                            <form asp-controller="Account"
                                                  asp-action="Logout"
                                                  method="post">
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="dropdown-item">
                                                    Logout
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Sign In
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success mt-3">
                    @success
                </div>
            }

            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger mt-3">
                    @error
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - Zuripro Medical Supplies
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
