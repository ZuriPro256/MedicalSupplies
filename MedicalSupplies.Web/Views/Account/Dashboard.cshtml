@model AccountDashboardViewModel
@{ ViewData["Title"] = "My Account"; }

<h1>Business Account</h1>
<p class="text-muted mb-1">@Model.DisplayName</p>
<p class="text-muted">Manage your quotations, orders, and account activity.</p>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <a asp-controller="Account"
           asp-action="Quotations"
           class="text-decoration-none text-reset">
            <div class="card text-center p-3 h-100">
                <div class="fs-2">@Model.QuotationCount</div>
                <div class="text-muted">Quotations</div>
            </div>
        </a>
    </div>

    <div class="col-md-4">
        <a asp-controller="Account"
           asp-action="Orders"
           class="text-decoration-none text-reset">
            <div class="card text-center p-3 h-100">
                <div class="fs-2">@Model.OrderCount</div>
                <div class="text-muted">Orders</div>
            </div>
        </a>
    </div>

    <div class="col-md-4">
        <a asp-controller="Account"
           asp-action="Quotations"
           class="text-decoration-none text-reset">
            <div class="card text-center p-3 h-100">
                <div class="fs-2">@Model.PendingQuotationCount</div>
                <div class="text-muted">Pending Quotations</div>
            </div>
        </a>
    </div>
</div>

<h4>Recent Orders</h4>
@if (Model.RecentOrders.Any())
{
    <ul class="list-group">
        @foreach (var order in Model.RecentOrders)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <a asp-action="OrderDetails" asp-route-id="@order.OrderId">@order.OrderNumber</a>
                <span class="badge bg-secondary">@order.OrderStatus</span>
            </li>
        }
    </ul>
}
else
{
    <p class="text-muted">No orders yet.</p>
}
