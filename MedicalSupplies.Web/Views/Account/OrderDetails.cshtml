@model MyOrderDetailsViewModel
@{ ViewData["Title"] = $"Order {Model.OrderNumber}"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Order @Model.OrderNumber</h1>
    <span class="badge bg-secondary fs-6">@Model.OrderStatus</span>
</div>

<p class="text-muted">
    Placed @Model.OrderDate.ToLocalTime().ToString("dd MMM yyyy") ·
    Delivery: @Model.DeliveryLocation
</p>

<table class="table bg-white">
    <thead><tr><th>Product</th><th>Qty</th><th>Unit Price</th><th>Total</th></tr></thead>
    <tbody>
    @foreach (var line in Model.Lines)
    {
        <tr>
            <td>@line.ProductName</td>
            <td>@line.Quantity</td>
            <td>UGX @line.UnitPrice.ToString("N0")</td>
            <td>UGX @line.TotalPrice.ToString("N0")</td>
        </tr>
    }
    </tbody>
    <tfoot>
        <tr><td colspan="3" class="text-end">Subtotal</td><td>UGX @Model.Subtotal.ToString("N0")</td></tr>
        <tr><td colspan="3" class="text-end">Discount</td><td>UGX @Model.Discount.ToString("N0")</td></tr>
        <tr class="fw-bold"><td colspan="3" class="text-end">Total</td><td>UGX @Model.TotalAmount.ToString("N0")</td></tr>
    </tfoot>
</table>

<div class="row">
    <div class="col-md-6">
        <h5>Order Status</h5>
        <p><span class="badge bg-secondary">@Model.OrderStatus</span></p>
        @if (Model.DispatchedDate is not null) { <p class="text-muted small">Dispatched: @Model.DispatchedDate.Value.ToLocalTime().ToString("dd MMM yyyy")</p> }
        @if (Model.DeliveredDate is not null) { <p class="text-muted small">Delivered: @Model.DeliveredDate.Value.ToLocalTime().ToString("dd MMM yyyy")</p> }
    </div>
    <div class="col-md-6">
        <h5>Payment</h5>
        <p><span class="badge bg-light text-dark">@Model.PaymentStatus</span></p>
        <p class="text-muted small">Paid so far: UGX @Model.AmountPaid.ToString("N0") of UGX @Model.TotalAmount.ToString("N0")</p>
    </div>
</div>

<a asp-action="Orders" class="btn btn-link">&larr; Back to My Orders</a>
