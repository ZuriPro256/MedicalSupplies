@model QuotationCartViewModel

@{
    ViewData["Title"] = "Your Quotation";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Your Quotation</h1>
        <p class="text-muted mb-0">
            Review your selected products and adjust quantities before submitting your request.
        </p>
    </div>

    <a asp-controller="Products"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Continue Shopping
    </a>
</div>

@if (!Model.Lines.Any())
{
    <div class="card shadow-sm border-0">
        <div class="card-body text-center py-5">
            <h2 class="h5 mb-2">Your quotation list is empty</h2>

            <p class="text-muted mb-4">
                Browse our medical supplies and add the products you need.
            </p>

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-primary">
                Browse Products
            </a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <strong>Selected Products</strong>
            <span class="text-muted ms-2">
                @Model.Lines.Count item@(Model.Lines.Count == 1 ? "" : "s")
            </span>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Product</th>
                        <th>Pack Size</th>
                        <th style="width:210px;">Quantity</th>
                        <th class="text-end pe-3">Action</th>
                    </tr>
                </thead>

                <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td class="ps-3">
                            <div class="fw-semibold">
                                @line.ProductName
                            </div>
                        </td>

                        <td>
                            <span class="text-muted">
                                @line.PackSize
                            </span>
                        </td>

                        <td>
                            <form asp-action="UpdateQuantity"
                                  method="post"
                                  class="d-flex align-items-center gap-2">

                                <input type="hidden"
                                       name="productId"
                                       value="@line.ProductId" />

                                <input type="number"
                                       name="quantity"
                                       value="@line.Quantity"
                                       min="1"
                                       class="form-control"
                                       style="width:95px;"
                                       aria-label="Quantity for @line.ProductName" />

                                <button type="submit"
                                        class="btn btn-outline-primary">
                                    Update
                                </button>
                            </form>
                        </td>

                        <td class="text-end pe-3">
                            <form asp-action="RemoveItem"
                                  method="post"
                                  class="d-inline">

                                <input type="hidden"
                                       name="productId"
                                       value="@line.ProductId" />

                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger">
                                    Remove
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm border-0 mt-4">
        <div class="card-body p-4">
            <div class="row align-items-center g-4">
                <div class="col-md">
                    <h2 class="h5 mb-1">Ready to submit your quotation?</h2>
                    <p class="text-muted mb-0">
                        Submit this list and we will confirm current pricing,
                        availability, sourcing and delivery details.
                    </p>
                </div>

                <div class="col-md-auto">
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="Products"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Continue Shopping
                        </a>

                        <a asp-action="Request"
                           class="btn btn-primary px-4">
                            Submit Quotation
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
