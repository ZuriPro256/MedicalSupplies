@model MedicalSupplies.Web.ViewModels.Admin.Inquiries.InquiryDetailsViewModel
@using MedicalSupplies.Core.Enums

@{
    ViewData["Title"] = "Inquiry Details";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Inquiry Details</h1>
        <p class="text-muted mb-0">
            Received @Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy 'at' HH:mm")
        </p>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Inquiries
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="mb-4">
                    <div class="small text-muted mb-1">Subject</div>
                    <h2 class="h4 mb-0">
                        @(string.IsNullOrWhiteSpace(Model.Subject)
                            ? "General enquiry"
                            : Model.Subject)
                    </h2>
                </div>

                <div>
                    <div class="small text-muted mb-2">Message</div>

                    <div class="border rounded-3 p-3 bg-light"
                         style="white-space: pre-line;">
                        @Model.Message
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white">
                <strong>Contact</strong>
            </div>

            <div class="card-body">
                <div class="mb-3">
                    <div class="small text-muted">Name</div>
                    <div class="fw-semibold">@Model.Name</div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.OrganizationName))
                {
                    <div class="mb-3">
                        <div class="small text-muted">Organisation</div>
                        <div class="fw-semibold">@Model.OrganizationName</div>
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <div class="small text-muted">Source</div>
                        <div>Website visitor</div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Email))
                {
                    <div class="mb-3">
                        <div class="small text-muted">Email</div>
                        <a href="mailto:@Model.Email">
                            @Model.Email
                        </a>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Phone))
                {
                    <div class="mb-3">
                        <div class="small text-muted">Phone</div>
                        <a href="tel:@Model.Phone">
                            @Model.Phone
                        </a>
                    </div>
                }

                @if (Model.CustomerId.HasValue)
                {
                    <a asp-area="Admin"
                       asp-controller="Customers"
                       asp-action="Details"
                       asp-route-id="@Model.CustomerId.Value"
                       class="btn btn-outline-primary btn-sm">
                        View Customer
                    </a>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <strong>Inquiry Status</strong>
            </div>

            <div class="card-body">
                <form asp-action="UpdateStatus"
                      method="post">

                    <input type="hidden"
                           name="id"
                           value="@Model.EnquiryId" />

                    <div class="mb-3">
                        <select name="status"
                                class="form-select">

                            @foreach (var item in Enum.GetValues<EnquiryStatus>())
                            {
                                if (Model.Status == item)
                                {
                                    <option value="@item" selected>
                                        @(item == EnquiryStatus.InProgress
                                            ? "In Progress"
                                            : item.ToString())
                                    </option>
                                }
                                else
                                {
                                    <option value="@item">
                                        @(item == EnquiryStatus.InProgress
                                            ? "In Progress"
                                            : item.ToString())
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Update Status
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
