@model List<InventoryBatch>
@{ ViewData["Title"] = "Inventory Batches"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Inventory Batches</h1>
    <a class="btn btn-primary" asp-action="Create" asp-route-productId="@ViewBag.ProductId">+ Receive Batch</a>
</div>

<table class="table table-striped bg-white">
    <thead>
        <tr>
            <th>Product</th><th>Batch #</th><th>Supplier</th>
            <th>Expiry</th><th>Available</th><th>Received</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var batch in Model)
    {
        var isExpiringSoon = batch.ExpiryDate.HasValue &&
            batch.ExpiryDate.Value <= DateOnly.FromDateTime(DateTime.UtcNow.AddDays(90));
        <tr class="@(isExpiringSoon ? "table-warning" : "")">
            <td>@batch.Product.ProductName</td>
            <td>@batch.BatchNumber</td>
            <td>@batch.Supplier?.SupplierName</td>
            <td>
                @batch.ExpiryDate
                @if (isExpiringSoon)
                {
                    <span class="badge bg-warning text-dark">Expiring soon</span>
                }
            </td>
            <td>@batch.QuantityAvailable</td>
            <td>@batch.QuantityReceived</td>
        </tr>
    }
    </tbody>
</table>
