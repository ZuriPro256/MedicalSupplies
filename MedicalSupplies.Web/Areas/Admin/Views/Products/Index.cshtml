@model List<ProductListItemViewModel>
@{ ViewData["Title"] = "Products"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Products</h1>
    <a class="btn btn-primary" asp-action="Create">+ Add Product</a>
</div>

<form method="get" class="mb-3 col-md-4">
    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name or code..." />
</form>

<table class="table table-striped bg-white align-middle">
    <thead>
        <tr>
            <th>Code</th><th>Name</th><th>Category</th><th>Brand</th>
            <th>Price</th><th>Stock</th><th>Active</th><th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var product in Model)
    {
        <tr>
            <td>@product.ProductCode</td>
            <td>@product.ProductName</td>
            <td>@product.CategoryName</td>
            <td>@product.BrandName</td>
            <td>@(product.SellingPrice is null ? "Request quote" : $"UGX {product.SellingPrice:N0}")</td>
            <td>
                @product.TotalAvailable
                @if (product.IsLowStock)
                {
                    <span class="badge bg-warning text-dark">Low stock</span>
                }
            </td>
            <td>@(product.IsActive ? "Yes" : "No")</td>
            <td>
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@product.ProductId">Edit</a>
                <a class="btn btn-sm btn-outline-secondary" asp-controller="InventoryBatches" asp-action="Index" asp-route-productId="@product.ProductId">Batches</a>
            </td>
        </tr>
    }
    </tbody>
</table>
