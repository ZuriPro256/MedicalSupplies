@model MedicalSupplies.Web.ViewModels.Admin.AdminNotificationCountsViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Zuripro Medical Supplies</h1>
        <p class="text-muted mb-0">Admin Dashboard</p>
    </div>
</div>

<h4 class="mb-3">Needs Attention</h4>

<div class="row g-3">

    @if (Model.CanSeeInquiries)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted mb-2">New Inquiries</h6>
                            <div class="display-6 fw-bold">@Model.Inquiries</div>
                        </div>

                        @if (Model.Inquiries > 0)
                        {
                            <span class="badge bg-danger rounded-pill">
                                @Model.Inquiries
                            </span>
                        }
                    </div>

                    <a asp-area="Admin"
                       asp-controller="Inquiries"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-primary mt-3">
                        View Inquiries
                    </a>
                </div>
            </div>
        </div>
    }

    @if (Model.CanSeeQuotations)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted mb-2">Pending Quotations</h6>
                            <div class="display-6 fw-bold">@Model.Quotations</div>
                        </div>

                        @if (Model.Quotations > 0)
                        {
                            <span class="badge bg-danger rounded-pill">
                                @Model.Quotations
                            </span>
                        }
                    </div>

                    <a asp-area="Admin"
                       asp-controller="Quotations"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-primary mt-3">
                        View Quotations
                    </a>
                </div>
            </div>
        </div>
    }

    @if (Model.CanSeeOrders)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted mb-2">New Orders</h6>
                            <div class="display-6 fw-bold">@Model.Orders</div>
                        </div>

                        @if (Model.Orders > 0)
                        {
                            <span class="badge bg-danger rounded-pill">
                                @Model.Orders
                            </span>
                        }
                    </div>

                    <a asp-area="Admin"
                       asp-controller="Orders"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-primary mt-3">
                        View Orders
                    </a>
                </div>
            </div>
        </div>
    }

    @if (Model.CanSeeAccountRecovery)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted mb-2">Account Recovery</h6>
                            <div class="display-6 fw-bold">@Model.AccountRecovery</div>
                        </div>

                        @if (Model.AccountRecovery > 0)
                        {
                            <span class="badge bg-danger rounded-pill">
                                @Model.AccountRecovery
                            </span>
                        }
                    </div>

                    <a asp-area="Admin"
                       asp-controller="AccountRecovery"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-primary mt-3">
                        View Requests
                    </a>
                </div>
            </div>
        </div>
    }

    @if (Model.CanSeePurchaseOrders)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted mb-2">POs Awaiting Approval</h6>
                            <div class="display-6 fw-bold">@Model.PurchaseOrders</div>
                        </div>

                        @if (Model.PurchaseOrders > 0)
                        {
                            <span class="badge bg-danger rounded-pill">
                                @Model.PurchaseOrders
                            </span>
                        }
                    </div>

                    <a asp-area="Admin"
                       asp-controller="PurchaseOrders"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-primary mt-3">
                        View Purchase Orders
                    </a>
                </div>
            </div>
        </div>
    }

</div>

<div class="mt-4 p-3 bg-light border rounded">
    <strong>How the numbers work:</strong>
    they show only items currently waiting for staff action.
    Once an item moves forward in its workflow, its notification count drops.
</div>
