@model MedicalSupplies.Web.ViewModels.Admin.QuotationOfferEditViewModel

@{
    ViewData["Title"] = $"Edit Revised Offer {Model.OfferNumber}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Edit Revised Offer</h1>
        <div class="text-muted">
            @Model.OfferNumber · Revision @Model.RevisionNumber
        </div>
    </div>

    <a asp-action="OfferDetails"
       asp-route-id="@Model.QuotationOfferId"
       class="btn btn-outline-secondary">
        Back to Offer
    </a>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <strong>Customer</strong>
                <div>@Model.CustomerName</div>
            </div>

            <div class="col-md-6">
                <strong>Offer</strong>
                <div>@Model.OfferNumber</div>
            </div>
        </div>
    </div>
</div>

<form asp-action="SaveOffer"
      asp-route-id="@Model.QuotationOfferId"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="QuotationOfferId" />
    <input type="hidden" asp-for="QuotationId" />
    <input type="hidden" asp-for="OfferNumber" />
    <input type="hidden" asp-for="RevisionNumber" />
    <input type="hidden" asp-for="CustomerName" />

    <div class="card mb-4">
        <div class="card-header">
            <strong>Offer Lines</strong>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Pack Size</th>
                            <th style="width: 130px;">Quantity</th>
                            <th style="width: 180px;">Unit Price (UGX)</th>
                            <th class="text-end">Line Total</th>
                        </tr>
                    </thead>

                    <tbody>
                    @for (var i = 0; i < Model.Lines.Count; i++)
                    {
                        <tr>
                            <td>
                                <strong>@Model.Lines[i].ProductName</strong>

                                <input type="hidden"
                                       asp-for="Lines[i].QuotationOfferDetailId" />

                                <input type="hidden"
                                       asp-for="Lines[i].ProductId" />

                                <input type="hidden"
                                       asp-for="Lines[i].ProductName" />

                                <input type="hidden"
                                       asp-for="Lines[i].PackSize" />
                            </td>

                            <td>@Model.Lines[i].PackSize</td>

                            <td>
                                <input asp-for="Lines[i].Quantity"
                                       class="form-control offer-quantity"
                                       min="1"
                                       type="number" />
                                <span asp-validation-for="Lines[i].Quantity"
                                      class="text-danger"></span>
                            </td>

                            <td>
                                <input asp-for="Lines[i].UnitPrice"
                                       class="form-control offer-unit-price"
                                       min="0"
                                       step="0.01"
                                       type="number" />
                                <span asp-validation-for="Lines[i].UnitPrice"
                                      class="text-danger"></span>
                            </td>

                            <td class="text-end fw-semibold">
                                <span class="line-total">0</span>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">

            <div class="card mb-4">
                <div class="card-header">
                    <strong>Offer Terms</strong>
                </div>

                <div class="card-body">

                    <div class="mb-3">
                        <label asp-for="DiscountAmount"
                               class="form-label">
                            Discount (UGX)
                        </label>

                        <input asp-for="DiscountAmount"
                               class="form-control"
                               id="discountAmount"
                               min="0"
                               step="0.01"
                               type="number" />

                        <div class="form-text">
                            Enter 0 if there is no discount.
                        </div>

                        <span asp-validation-for="DiscountAmount"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DeliveryCost"
                               class="form-label">
                            Delivery / Transport Cost (UGX)
                        </label>

                        <input asp-for="DeliveryCost"
                               class="form-control"
                               id="deliveryCost"
                               min="0"
                               step="0.01"
                               type="number" />

                        <div class="form-text">
                            Enter 0 if delivery is free.
                        </div>

                        <span asp-validation-for="DeliveryCost"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ValidUntil"
                               class="form-label">
                            Valid Until
                        </label>

                        <input asp-for="ValidUntil"
                               class="form-control"
                               type="date" />

                        <span asp-validation-for="ValidUntil"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-0">
                        <label asp-for="AdminNotes"
                               class="form-label">
                            Admin Notes
                        </label>

                        <textarea asp-for="AdminNotes"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Optional notes about pricing, delivery or the revised offer."></textarea>

                        <span asp-validation-for="AdminNotes"
                              class="text-danger"></span>
                    </div>

                </div>
            </div>

        </div>

        <div class="col-lg-5">

            <div class="card">
                <div class="card-header">
                    <strong>Offer Summary</strong>
                </div>

                <div class="card-body">

                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal</span>
                        <strong>
                            UGX <span id="subtotal">0</span>
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Discount</span>
                        <strong>
                            − UGX <span id="discountDisplay">0</span>
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span>Delivery / Transport</span>
                        <strong>
                            + UGX <span id="deliveryDisplay">0</span>
                        </strong>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fs-5 fw-bold">Grand Total</span>
                        <span class="fs-4 fw-bold">
                            UGX <span id="grandTotal">0</span>
                        </span>
                    </div>

                    <div class="mt-4">
                        <button type="submit"
                                class="btn btn-primary w-100">
                            Save Draft
                        </button>
                    </div>

                </div>
            </div>

        </div>
    </div>

</form>

@section Scripts {

    <script>
        function numberValue(element) {
            const value = parseFloat(element.value);
            return Number.isFinite(value) ? value : 0;
        }

        function formatUgx(value) {
            return Math.max(0, value).toLocaleString('en-US', {
                maximumFractionDigits: 0
            });
        }

        function recalculateOffer() {
            let subtotal = 0;

            document.querySelectorAll('tbody tr').forEach(function (row) {
                const quantity = numberValue(
                    row.querySelector('.offer-quantity')
                );

                const unitPrice = numberValue(
                    row.querySelector('.offer-unit-price')
                );

                const lineTotal = quantity * unitPrice;

                const display = row.querySelector('.line-total');

                if (display) {
                    display.textContent = formatUgx(lineTotal);
                }

                subtotal += lineTotal;
            });

            const discount = Math.max(
                0,
                numberValue(document.getElementById('discountAmount'))
            );

            const delivery = Math.max(
                0,
                numberValue(document.getElementById('deliveryCost'))
            );

            const grandTotal = Math.max(
                0,
                subtotal - discount + delivery
            );

            document.getElementById('subtotal').textContent =
                formatUgx(subtotal);

            document.getElementById('discountDisplay').textContent =
                formatUgx(discount);

            document.getElementById('deliveryDisplay').textContent =
                formatUgx(delivery);

            document.getElementById('grandTotal').textContent =
                formatUgx(grandTotal);
        }

        document.querySelectorAll(
            '.offer-quantity, .offer-unit-price, #discountAmount, #deliveryCost'
        ).forEach(function (element) {
            element.addEventListener('input', recalculateOffer);
        });

        recalculateOffer();
    </script>
}
