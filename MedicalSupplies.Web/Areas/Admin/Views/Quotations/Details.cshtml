@model QuotationPricingViewModel

@if (Model.Status == MedicalSupplies.Core.Enums.QuotationStatus.Rejected)
{
    <div class="card border-warning mb-4">
        <div class="card-body">
            <h5 class="card-title">Quotation Negotiation</h5>
            <p class="text-muted mb-3">
                The customer rejected this quotation. You can create a separate revised offer
                without changing the original quotation or its rejection history.
            </p>

            <form asp-action="CreateRevisedOffer"
                  asp-route-id="@Model.QuotationId"
                  method="post">
                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-warning">
                    Create Revised Offer
                </button>
            </form>
        </div>
    </div>
}

@{
    ViewData["Title"] = $"Quotation {Model.QuotationNumber}";
    var isEditable = Model.Status is MedicalSupplies.Core.Enums.QuotationStatus.Pending
        or MedicalSupplies.Core.Enums.QuotationStatus.Pricing
        or MedicalSupplies.Core.Enums.QuotationStatus.Sent;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Quotation @Model.QuotationNumber</h1>
    <span class="badge bg-secondary fs-6">@Model.Status</span>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <h5>Customer</h5>
        <p class="mb-1">@Model.CustomerName @(Model.OrganizationName is not null ? $"({Model.OrganizationName})" : "")</p>
        <p class="mb-1 text-muted">@Model.CustomerEmail · @Model.CustomerPhone</p>
        <p class="text-muted">Requested @Model.RequestDate.ToLocalTime().ToString("dd MMM yyyy")</p>
        @if (Model.CustomerNotes is not null)
        {
            <p><strong>Customer notes:</strong> @Model.CustomerNotes</p>
        }
    </div>
</div>

@if (Model.Status == MedicalSupplies.Core.Enums.QuotationStatus.Rejected
    && Model.RejectionReason is not null)
{
    <div class="card border-warning mb-4">
        <div class="card-header bg-warning-subtle">
            <strong>Customer Rejection Feedback</strong>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Reason</dt>
                <dd class="col-sm-8">
                    @switch (Model.RejectionReason)
                    {
                        case MedicalSupplies.Core.Enums.QuotationRejectionReason.PriceTooHigh:
                            <text>Price is too high</text>
                            break;
                        case MedicalSupplies.Core.Enums.QuotationRejectionReason.FoundBetterPrice:
                            <text>I found a better price</text>
                            break;
                        case MedicalSupplies.Core.Enums.QuotationRejectionReason.QuantityNotSuitable:
                            <text>Quantity is not suitable</text>
                            break;
                        case MedicalSupplies.Core.Enums.QuotationRejectionReason.DeliveryIssue:
                            <text>Delivery terms/location</text>
                            break;
                        case MedicalSupplies.Core.Enums.QuotationRejectionReason.NoLongerNeeded:
                            <text>No longer needed</text>
                            break;
                        case MedicalSupplies.Core.Enums.QuotationRejectionReason.Other:
                            <text>Other</text>
                            break;
                    }
                </dd>

                @if (Model.CustomerExpectedPrice.HasValue)
                {
                    <dt class="col-sm-4">Customer Expected Price</dt>
                    <dd class="col-sm-8">
                        <strong>UGX @Model.CustomerExpectedPrice.Value.ToString("N0")</strong>
                    </dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.CustomerRejectionComment))
                {
                    <dt class="col-sm-4">Customer Comments</dt>
                    <dd class="col-sm-8">
                        @Model.CustomerRejectionComment
                    </dd>
                }

                @if (Model.RejectedDate.HasValue)
                {
                    <dt class="col-sm-4">Rejected On</dt>
                    <dd class="col-sm-8">
                        @Model.RejectedDate.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                    </dd>
                }
            </dl>
        </div>
    </div>
}

@if (Model.Offers.Any())
{
    <div class="card mb-4">
        <div class="card-header">
            <strong>Revision History</strong>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Offer</th>
                            <th>Revision</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Total</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var offer in Model.Offers)
                    {
                        <tr>
                            <td>
                                <strong>@offer.OfferNumber</strong>
                            </td>
                            <td>R@(offer.RevisionNumber)</td>
                            <td>
                                <span class="badge bg-secondary">
                                    @offer.Status
                                </span>
                            </td>
                            <td>
                                @offer.CreatedDate.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                            </td>
                            <td>
                                @(offer.TotalAmount.HasValue
                                    ? $"UGX {offer.TotalAmount.Value:N0}"
                                    : "—")
                            </td>
                            <td class="text-end">
                                <a asp-action="OfferDetails"
                                   asp-route-id="@offer.QuotationOfferId"
                                   class="btn btn-sm btn-outline-primary">
                                    View Offer
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if (Model.AcceptedOffer is not null)
{
    <div class="card border-success mb-4">
        <div class="card-header bg-success-subtle">
            <strong>Accepted Offer — R@(Model.AcceptedOffer.RevisionNumber)</strong>
            <span class="text-muted ms-2">@Model.AcceptedOffer.OfferNumber</span>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Qty</th>
                            <th class="text-end">Unit Price (UGX)</th>
                            <th class="text-end">Total (UGX)</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var line in Model.AcceptedOffer.Lines)
                    {
                        <tr>
                            <td>
                                @line.ProductName
                                @if (!string.IsNullOrWhiteSpace(line.PackSize))
                                {
                                    <span class="text-muted">(@line.PackSize)</span>
                                }
                            </td>
                            <td>@line.Quantity</td>
                            <td class="text-end">@line.UnitPrice.ToString("N0")</td>
                            <td class="text-end">@line.LineTotal.ToString("N0")</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end">Subtotal</td>
                            <td class="text-end">
                                UGX @Model.AcceptedOffer.SubTotal.ToString("N0")
                            </td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end">Discount</td>
                            <td class="text-end">
                                UGX @Model.AcceptedOffer.DiscountAmount.ToString("N0")
                            </td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end">Delivery / Transport</td>
                            <td class="text-end">
                                UGX @Model.AcceptedOffer.DeliveryCost.ToString("N0")
                            </td>
                        </tr>
                        <tr class="fw-bold">
                            <td colspan="3" class="text-end">TOTAL TO ORDER</td>
                            <td class="text-end">
                                UGX @Model.AcceptedOffer.GrandTotal.ToString("N0")
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="mt-3">
                <a asp-action="OfferDetails"
                   asp-route-id="@Model.AcceptedOffer.QuotationOfferId"
                   class="btn btn-sm btn-outline-primary">
                    View Accepted Offer
                </a>
            </div>
        </div>
    </div>
}
else
{
<form asp-action="SavePricing" method="post">
    <input type="hidden" asp-for="QuotationId" />

    <table class="table bg-white align-middle">
        <thead>
            <tr>
                <th>Product</th><th>Qty</th><th>Requested Price</th><th style="width:180px;">Admin Price (UGX)</th><th>Total</th>
            </tr>
        </thead>
        <tbody>
        @for (var i = 0; i < Model.Lines.Count; i++)
        {
            <tr>
                <td>
                    @Model.Lines[i].ProductName
                    <input type="hidden" asp-for="Lines[i].QuotationDetailId" />
                </td>
                <td>@Model.Lines[i].Quantity @Model.Lines[i].PackSize</td>
                <td class="text-muted">—</td>
                <td>
                    @if (isEditable)
                    {
                        <input asp-for="Lines[i].UnitPrice" class="form-control line-price" data-qty="@Model.Lines[i].Quantity" />
                    }
                    else
                    {
                        <span>@(Model.Lines[i].UnitPrice is null ? "—" : $"{Model.Lines[i].UnitPrice:N0}")</span>
                    }
                </td>
                <td class="line-total">@Model.Lines[i].LineTotal.ToString("N0")</td>
            </tr>
        }
        </tbody>
    </table>

    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="DeliveryLocation" class="form-label"></label>
                @if (isEditable)
                {
                    <input asp-for="DeliveryLocation" class="form-control" />
                }
                else
                {
                    <p>@Model.DeliveryLocation</p>
                }
            </div>
            <div class="mb-3">
                <label asp-for="AdminNotes" class="form-label"></label>
                @if (isEditable)
                {
                    <textarea asp-for="AdminNotes" class="form-control" rows="3"></textarea>
                }
                else
                {
                    <p>@Model.AdminNotes</p>
                }
            </div>
        </div>
        <div class="col-md-6">
            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="DiscountAmount" class="form-label"></label>
                    @if (isEditable)
                    {
                        <input asp-for="DiscountAmount" id="discountInput" class="form-control" />
                    }
                    else
                    {
                        <p>@(Model.DiscountAmount is null ? "—" : $"UGX {Model.DiscountAmount:N0}")</p>
                    }
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="ValidUntil" class="form-label"></label>
                    @if (isEditable)
                    {
                        <input asp-for="ValidUntil" class="form-control" />
                    }
                    else
                    {
                        <p>@Model.ValidUntil</p>
                    }
                </div>
            </div>

            <table class="table table-sm">
                <tr><td>Subtotal</td><td class="text-end" id="subtotalCell">UGX @Model.SubTotal.ToString("N0")</td></tr>
                <tr><td>Discount</td><td class="text-end" id="discountCell">UGX @((Model.DiscountAmount ?? 0).ToString("N0"))</td></tr>
                <tr class="fw-bold"><td>Grand Total</td><td class="text-end" id="grandTotalCell">UGX @Model.GrandTotal.ToString("N0")</td></tr>
            </table>
        </div>
    </div>

    @if (isEditable)
    {
        <button type="submit" name="submitAction" value="save" class="btn btn-outline-primary">Save Quote</button>
        <button type="submit" name="submitAction" value="send" class="btn btn-primary">Send to Customer</button>
    }
</form>

}
@if (Model.Status == MedicalSupplies.Core.Enums.QuotationStatus.Sent)
{
    <div class="mt-3 d-flex gap-2">
        <form asp-action="Accept" asp-route-id="@Model.QuotationId" method="post"
              onsubmit="return confirm('Mark this quotation as accepted by the customer?');">
            <button type="submit" class="btn btn-success">Accept</button>
        </form>
        <form asp-action="Reject" asp-route-id="@Model.QuotationId" method="post"
              onsubmit="return confirm('Mark this quotation as rejected?');">
            <button type="submit" class="btn btn-outline-danger">Reject</button>
        </form>
    </div>
}

@if (Model.Status == MedicalSupplies.Core.Enums.QuotationStatus.Accepted)
{
    <form asp-action="ConvertToOrder" asp-route-id="@Model.QuotationId" method="post" class="mt-3"
          onsubmit="return confirm('Create an order from this quotation?');">
        <button type="submit" class="btn btn-primary">Convert to Order</button>
    </form>
}

@if (Model.Status == MedicalSupplies.Core.Enums.QuotationStatus.ConvertedToOrder)
{
    <p class="mt-3 text-muted">This quotation has already been converted to an order.</p>
}

<a asp-action="Index" class="btn btn-link mt-3">&larr; Back to Quotations</a>

@section Scripts {
<script>
    // Live subtotal/total preview as the admin edits prices/discount — the
    // server recalculates authoritatively on save, this is just UX feedback.
    document.querySelectorAll('.line-price').forEach(function (input) {
        input.addEventListener('input', recalculate);
    });
    var discountInput = document.getElementById('discountInput');
    if (discountInput) discountInput.addEventListener('input', recalculate);

    function recalculate() {
        var subtotal = 0;
        document.querySelectorAll('.line-price').forEach(function (input) {
            var qty = parseFloat(input.dataset.qty) || 0;
            var price = parseFloat(input.value) || 0;
            var lineTotal = qty * price;
            input.closest('tr').querySelector('.line-total').textContent = lineTotal.toLocaleString(undefined, { maximumFractionDigits: 0 });
            subtotal += lineTotal;
        });
        var discount = parseFloat(discountInput?.value) || 0;
        var grandTotal = Math.max(0, subtotal - discount);
        document.getElementById('subtotalCell').textContent = 'UGX ' + subtotal.toLocaleString(undefined, { maximumFractionDigits: 0 });
        document.getElementById('discountCell').textContent = 'UGX ' + discount.toLocaleString(undefined, { maximumFractionDigits: 0 });
        document.getElementById('grandTotalCell').textContent = 'UGX ' + grandTotal.toLocaleString(undefined, { maximumFractionDigits: 0 });
    }
</script>
}
