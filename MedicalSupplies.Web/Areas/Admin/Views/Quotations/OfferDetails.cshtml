@model MedicalSupplies.Core.Entities.QuotationOffer

@{
    ViewData["Title"] = $"Revised Offer {Model.OfferNumber}";
    var customerName = Model.Quotation.Customer.OrganizationName
        ?? $"{Model.Quotation.Customer.FirstName} {Model.Quotation.Customer.LastName}".Trim();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Revised Offer</h1>
        <div class="text-muted">@Model.OfferNumber</div>
    </div>

    <div class="d-flex gap-2">
        @if (Model.Status == MedicalSupplies.Core.Enums.QuotationOfferStatus.Draft)
        {
            <a asp-action="EditOffer"
               asp-route-id="@Model.QuotationOfferId"
               class="btn btn-primary">
                Edit Offer
            </a>

            <form asp-action="SendOffer"
                  asp-route-id="@Model.QuotationOfferId"
                  method="post"
                  class="d-inline">
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-success"
                        onclick="return confirm('Send this revised offer to the customer?');">
                    Send Offer
                </button>
            </form>
        }

        <a asp-action="Details"
           asp-route-id="@Model.QuotationId"
           class="btn btn-outline-secondary">
            Back to Quotation
        </a>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <strong>Customer</strong>
                <div>@customerName</div>
            </div>

            <div class="col-md-4">
                <strong>Quotation</strong>
                <div>@Model.Quotation.QuotationNumber</div>
            </div>

            <div class="col-md-4">
                <strong>Revision</strong>
                <div>Revision @Model.RevisionNumber</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <strong>Offer Lines</strong>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Pack Size</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>

                <tbody>
                @foreach (var line in Model.Details)
                {
                    <tr>
                        <td>@line.Product.ProductName</td>
                        <td>@line.Product.PackSize</td>
                        <td class="text-end">@line.Quantity</td>
                        <td class="text-end">
                            @(line.UnitPrice?.ToString("N0") ?? "-")
                        </td>
                        <td class="text-end">
                            @(line.TotalPrice?.ToString("N0") ?? "-")
                        </td>
                    </tr>
                }
                </tbody>

                <tfoot>
                    <tr>
                        <th colspan="4" class="text-end">Subtotal</th>
                        <th class="text-end">
                            @Model.Details.Sum(d => d.TotalPrice ?? 0).ToString("N0")
                        </th>
                    </tr>

                    <tr>
                        <th colspan="4" class="text-end">Discount</th>
                        <th class="text-end">
                            @((Model.DiscountAmount ?? 0).ToString("N0"))
                        </th>
                    </tr>

                    <tr>
                        <th colspan="4" class="text-end">Delivery / Transport</th>
                        <th class="text-end">
                            @Model.DeliveryCost.ToString("N0")
                        </th>
                    </tr>

                    <tr>
                        <th colspan="4" class="text-end">Total</th>
                        <th class="text-end">
                            @((Model.TotalAmount ?? 0).ToString("N0"))
                        </th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<div class="mt-4">
    <div class="alert alert-info mb-0">
        <strong>Status:</strong> @Model.Status
    </div>
</div>
