@model PurchaseOrderFormViewModel

<div class="row">
    <div class="col-md-5 mb-3">
        <label asp-for="SupplierId" class="form-label"></label>
        <select asp-for="SupplierId" class="form-select">
            <option value="">-- Select --</option>
            @foreach (var opt in Model.SupplierOptions)
            {
                <option value="@opt.Value">@opt.Text</option>
            }
        </select>
        <span asp-validation-for="SupplierId" class="text-danger"></span>
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="ExpectedDeliveryDate" class="form-label"></label>
        <input asp-for="ExpectedDeliveryDate" class="form-control" />
    </div>
    <div class="col-md-2 mb-3">
        <label asp-for="Currency" class="form-label"></label>
        <input asp-for="Currency" class="form-control" />
    </div>
</div>

<h5 class="mt-3">Line Items</h5>
<table class="table" id="lineItemsTable">
    <thead>
        <tr><th>Product</th><th style="width:120px;">Quantity</th><th style="width:160px;">Unit Cost</th><th style="width:140px;">Total</th><th></th></tr>
    </thead>
    <tbody>
    @for (var i = 0; i < Model.Lines.Count; i++)
    {
        <tr class="line-row">
            <td>
                <select name="Lines[@i].ProductId" class="form-select line-product">
                    <option value="">-- Select --</option>
                    @foreach (var opt in Model.ProductOptions)
                    {
                        <option value="@opt.Value" selected="@(opt.Value == Model.Lines[i].ProductId)">@opt.Text</option>
                    }
                </select>
            </td>
            <td><input type="number" name="Lines[@i].Quantity" value="@Model.Lines[i].Quantity" min="1" class="form-control line-qty" /></td>
            <td><input type="number" step="0.01" name="Lines[@i].UnitCost" value="@Model.Lines[i].UnitCost" min="0" class="form-control line-cost" /></td>
            <td class="line-total align-middle">@((Model.Lines[i].Quantity * Model.Lines[i].UnitCost).ToString("N0"))</td>
            <td><button type="button" class="btn btn-sm btn-outline-danger remove-row">&times;</button></td>
        </tr>
    }
    </tbody>
</table>
<button type="button" id="addRow" class="btn btn-sm btn-outline-secondary mb-3">+ Add Product Line</button>

<div class="row">
    <div class="col-md-3 mb-3">
        <label asp-for="DeliveryCost" class="form-label"></label>
        <input asp-for="DeliveryCost" class="form-control" id="deliveryCostInput" />
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="TaxAmount" class="form-label"></label>
        <input asp-for="TaxAmount" class="form-control" id="taxInput" />
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="1"></textarea>
    </div>
</div>

<table class="table table-sm w-auto ms-auto">
    <tr><td class="text-end pe-3">Subtotal</td><td id="subtotalCell">0</td></tr>
    <tr><td class="text-end pe-3">Delivery + Tax</td><td id="extrasCell">0</td></tr>
    <tr class="fw-bold"><td class="text-end pe-3">Total</td><td id="grandTotalCell">0</td></tr>
</table>

@section Scripts {
<script>
    var rowIndex = @Model.Lines.Count;
    var productOptionsHtml = document.querySelector('.line-product').innerHTML;

    document.getElementById('addRow').addEventListener('click', function () {
        var tbody = document.querySelector('#lineItemsTable tbody');
        var row = document.createElement('tr');
        row.className = 'line-row';
        row.innerHTML =
            '<td><select name="Lines[' + rowIndex + '].ProductId" class="form-select line-product">' + productOptionsHtml + '</select></td>' +
            '<td><input type="number" name="Lines[' + rowIndex + '].Quantity" value="1" min="1" class="form-control line-qty" /></td>' +
            '<td><input type="number" step="0.01" name="Lines[' + rowIndex + '].UnitCost" value="0" min="0" class="form-control line-cost" /></td>' +
            '<td class="line-total align-middle">0</td>' +
            '<td><button type="button" class="btn btn-sm btn-outline-danger remove-row">&times;</button></td>';
        tbody.appendChild(row);
        rowIndex++;
        attachRowEvents(row);
        recalc();
    });

    function attachRowEvents(row) {
        row.querySelector('.line-qty').addEventListener('input', recalc);
        row.querySelector('.line-cost').addEventListener('input', recalc);
        row.querySelector('.remove-row').addEventListener('click', function () {
            row.remove();
            recalc();
        });
    }

    document.querySelectorAll('.line-row').forEach(attachRowEvents);
    document.getElementById('deliveryCostInput').addEventListener('input', recalc);
    document.getElementById('taxInput').addEventListener('input', recalc);

    function recalc() {
        var subtotal = 0;
        document.querySelectorAll('.line-row').forEach(function (row) {
            var qty = parseFloat(row.querySelector('.line-qty').value) || 0;
            var cost = parseFloat(row.querySelector('.line-cost').value) || 0;
            var total = qty * cost;
            row.querySelector('.line-total').textContent = total.toLocaleString(undefined, { maximumFractionDigits: 0 });
            subtotal += total;
        });
        var extras = (parseFloat(document.getElementById('deliveryCostInput').value) || 0) +
                      (parseFloat(document.getElementById('taxInput').value) || 0);
        document.getElementById('subtotalCell').textContent = subtotal.toLocaleString(undefined, { maximumFractionDigits: 0 });
        document.getElementById('extrasCell').textContent = extras.toLocaleString(undefined, { maximumFractionDigits: 0 });
        document.getElementById('grandTotalCell').textContent = (subtotal + extras).toLocaleString(undefined, { maximumFractionDigits: 0 });
    }

    recalc();
</script>
}
