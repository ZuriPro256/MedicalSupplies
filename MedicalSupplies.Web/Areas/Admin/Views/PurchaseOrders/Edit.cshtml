@model PurchaseOrderFormViewModel
@{ ViewData["Title"] = "Edit Purchase Order"; }

<h1>Edit Purchase Order</h1>

<form asp-action="Edit" asp-route-id="@ViewBag.PurchaseOrderId" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_FormFields" />
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Details" asp-route-id="@ViewBag.PurchaseOrderId" class="btn btn-outline-secondary">Cancel</a>
</form>
