@model List<SupplierListItemViewModel>
@{ ViewData["Title"] = "Suppliers"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Suppliers</h1>
    <a class="btn btn-primary" asp-action="Create">+ Add Supplier</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name or code..." />
    </div>
    <div class="col-md-2">
        <select name="isActive" class="form-select">
            <option value="">All</option>
            <option value="true" selected="@(ViewBag.IsActive == true)">Active</option>
            <option value="false" selected="@(ViewBag.IsActive == false)">Inactive</option>
        </select>
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-primary">Go</button>
    </div>
</form>

<table class="table table-striped bg-white align-middle">
    <thead>
        <tr><th>Code</th><th>Name</th><th>Country</th><th>Phone</th><th>Email</th><th>Active</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr class="@(s.IsActive ? "" : "text-muted")">
            <td>@s.SupplierCode</td>
            <td>@s.SupplierName</td>
            <td>@s.Country</td>
            <td>@s.Phone</td>
            <td>@s.Email</td>
            <td>@(s.IsActive ? "Yes" : "No")</td>
            <td>
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@s.SupplierId">View</a>
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@s.SupplierId">Edit</a>
                @if (s.IsActive)
                {
                    <form asp-action="Deactivate" asp-route-id="@s.SupplierId" method="post" class="d-inline"
                          onsubmit="return confirm('Deactivate this supplier?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                    </form>
                }
                else
                {
                    <form asp-action="Reactivate" asp-route-id="@s.SupplierId" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-success">Reactivate</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No suppliers found.</p>
}
