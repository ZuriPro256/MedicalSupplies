@model SupplierDetailsViewModel
@{ ViewData["Title"] = Model.SupplierName; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Model.SupplierName</h1>
    <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">@(Model.IsActive ? "Active" : "Inactive")</span>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <p><strong>Code:</strong> @Model.SupplierCode</p>
        <p><strong>Contact:</strong> @Model.ContactPerson</p>
        <p><strong>Phone:</strong> @Model.Phone</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Address:</strong> @Model.Address</p>
        <p><strong>Country:</strong> @Model.Country</p>
        <p><strong>Tax / VAT Number:</strong> @Model.TaxNumber</p>
        @if (Model.Notes is not null)
        {
            <p><strong>Notes:</strong> @Model.Notes</p>
        }
        <p class="text-muted small">Added @Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")</p>
    </div>
</div>

<a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.SupplierId">Edit</a>
<a class="btn btn-link" asp-action="Index">&larr; Back to Suppliers</a>

<h4 class="mt-4">Supplied Products</h4>
@if (Model.SuppliedProducts.Any())
{
    <table class="table table-sm bg-white">
        <thead><tr><th>Product</th><th>Batches</th><th>Currently Available</th></tr></thead>
        <tbody>
        @foreach (var p in Model.SuppliedProducts)
        {
            <tr>
                <td>@p.ProductName</td>
                <td>@p.BatchCount</td>
                <td>@p.TotalQuantityAvailable</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No products supplied yet.</p>
}

<h4 class="mt-4">Inventory Batches</h4>
@if (Model.InventoryBatches.Any())
{
    <table class="table table-sm bg-white">
        <thead><tr><th>Product</th><th>Batch #</th><th>Expiry</th><th>Received</th><th>Available</th><th>Received Date</th></tr></thead>
        <tbody>
        @foreach (var b in Model.InventoryBatches)
        {
            <tr>
                <td>@b.ProductName</td>
                <td>@b.BatchNumber</td>
                <td>@b.ExpiryDate</td>
                <td>@b.QuantityReceived</td>
                <td>@b.QuantityAvailable</td>
                <td>@b.ReceivedDate.ToLocalTime().ToString("dd MMM yyyy")</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No batches recorded from this supplier yet.</p>
}
