@using MedicalSupplies.Core.Security
@using Microsoft.AspNetCore.Authorization
@using MedicalSupplies.Web.Services
@inject IAuthorizationService AuthorizationService
@inject IAdminNotificationService AdminNotificationService

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin - Zuripro Medical Supplies</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
@{
    var notificationCounts =
        await AdminNotificationService.GetCountsAsync(User);
}
    <div class="d-flex">
        <nav class="bg-dark text-white p-3" style="width:220px; min-height:100vh;">
            <h5 class="text-white">Zuripro Admin</h5>

            <ul class="nav flex-column mt-4">

                <li class="nav-item">
                    <a class="nav-link text-white-50"
                       asp-area="Admin"
                       asp-controller="Dashboard"
                       asp-action="Index">
                        Dashboard
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white-50"
                       asp-area="Admin"
                       asp-controller="Categories"
                       asp-action="Index">
                        Categories
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white-50"
                       asp-area="Admin"
                       asp-controller="Brands"
                       asp-action="Index">
                        Brands
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white-50"
                       asp-area="Admin"
                       asp-controller="Products"
                       asp-action="Index">
                        Products
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white-50"
                       asp-area="Admin"
                       asp-controller="InventoryBatches"
                       asp-action="Index">
                        Inventory Batches
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white-50"
                       asp-area="Admin"
                       asp-controller="Suppliers"
                       asp-action="Index">
                        Suppliers
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white-50 d-flex justify-content-between align-items-center"
                       asp-area="Admin"
                       asp-controller="PurchaseOrders"
                       asp-action="Index">
                        <span>Purchase Orders</span>
                        @if (notificationCounts.PurchaseOrders > 0)
                        {
                            <span class="badge bg-danger rounded-pill">
                                @notificationCounts.PurchaseOrders
                            </span>
                        }
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white-50 d-flex justify-content-between align-items-center"
                       asp-area="Admin"
                       asp-controller="Quotations"
                       asp-action="Index">
                        <span>Quotations</span>
                        @if (notificationCounts.Quotations > 0)
                        {
                            <span class="badge bg-danger rounded-pill">
                                @notificationCounts.Quotations
                            </span>
                        }
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white-50 d-flex justify-content-between align-items-center"
                       asp-area="Admin"
                       asp-controller="Orders"
                       asp-action="Index">
                        <span>Orders</span>
                        @if (notificationCounts.Orders > 0)
                        {
                            <span class="badge bg-danger rounded-pill">
                                @notificationCounts.Orders
                            </span>
                        }
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white-50 d-flex justify-content-between align-items-center"
                       asp-area="Admin"
                       asp-controller="Inquiries"
                       asp-action="Index">
                        <span>Inquiries</span>
                        @if (notificationCounts.Inquiries > 0)
                        {
                            <span class="badge bg-danger rounded-pill">
                                @notificationCounts.Inquiries
                            </span>
                        }
                    </a>
                </li>

                @if ((await AuthorizationService.AuthorizeAsync(
                    User,
                    Permissions.Customers.View)).Succeeded)
                {
                    <li class="nav-item">
                        <a class="nav-link text-white-50"
                           asp-area="Admin"
                           asp-controller="Customers"
                           asp-action="Index">
                            Customers
                        </a>
                    </li>
                }

                @if ((await AuthorizationService.AuthorizeAsync(
                    User,
                    Permissions.AccountRecovery.View)).Succeeded)
                {
                    <li class="nav-item">
                        <a class="nav-link text-white-50 d-flex justify-content-between align-items-center"
                           asp-area="Admin"
                           asp-controller="AccountRecovery"
                           asp-action="Index">
                            <span>Account Recovery</span>
                            @if (notificationCounts.AccountRecovery > 0)
                            {
                                <span class="badge bg-danger rounded-pill">
                                    @notificationCounts.AccountRecovery
                                </span>
                            }
                        </a>
                    </li>
                }

                @if ((await AuthorizationService.AuthorizeAsync(
                    User,
                    Permissions.Staff.View)).Succeeded)
                {
                    <li class="nav-item mt-3">
                        <span class="nav-link text-white-50 text-uppercase small">
                            Administration
                        </span>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-white-50"
                           asp-area="Admin"
                           asp-controller="Staff"
                           asp-action="Index">
                            Staff
                        </a>
                    </li>
                }

                <li class="nav-item mt-3">
                    <a class="nav-link text-white-50"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Index">
                        &larr; Back to site
                    </a>
                </li>

            </ul>
        </nav>

        <main class="flex-fill p-4">

            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success">@success</div>
            }

            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger">@error</div>
            }

            @RenderBody()

        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
