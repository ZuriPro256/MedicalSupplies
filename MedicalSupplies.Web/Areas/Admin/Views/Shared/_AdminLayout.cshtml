<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin - Zuripro Medical Supplies</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
    <div class="d-flex">
        <nav class="bg-dark text-white p-3" style="width:220px; min-height:100vh;">
            <h5 class="text-white">Zuripro Admin</h5>
            <ul class="nav flex-column mt-4">
                <li class="nav-item"><a class="nav-link text-white-50" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="nav-item"><a class="nav-link text-white-50" asp-area="Admin" asp-controller="Categories" asp-action="Index">Categories</a></li>
                <li class="nav-item"><a class="nav-link text-white-50" asp-area="Admin" asp-controller="Brands" asp-action="Index">Brands</a></li>
                <li class="nav-item"><a class="nav-link text-white-50" asp-area="Admin" asp-controller="Products" asp-action="Index">Products</a></li>
                <li class="nav-item"><a class="nav-link text-white-50" asp-area="Admin" asp-controller="InventoryBatches" asp-action="Index">Inventory Batches</a></li>
                <li class="nav-item"><a class="nav-link text-white-50" asp-area="Admin" asp-controller="Suppliers" asp-action="Index">Suppliers</a></li>
                <li class="nav-item"><a class="nav-link text-white-50" asp-area="Admin" asp-controller="PurchaseOrders" asp-action="Index">Purchase Orders</a></li>
                <li class="nav-item"><a class="nav-link text-white-50" asp-area="Admin" asp-controller="Quotations" asp-action="Index">Quotations</a></li>
                <li class="nav-item"><a class="nav-link text-white-50" asp-area="Admin" asp-controller="Orders" asp-action="Index">Orders</a></li>
                <li class="nav-item mt-3"><a class="nav-link text-white-50" asp-area="" asp-controller="Home" asp-action="Index">&larr; Back to site</a></li>
            </ul>
        </nav>
        <main class="flex-fill p-4">
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success">@success</div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger">@error</div>
            }
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
