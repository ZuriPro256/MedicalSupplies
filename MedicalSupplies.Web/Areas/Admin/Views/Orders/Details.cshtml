@model OrderDetailsViewModel
@{ ViewData["Title"] = $"Order {Model.OrderNumber}"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Order @Model.OrderNumber</h1>
    <span class="badge bg-secondary fs-6">@Model.OrderStatus</span>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <h5>Customer</h5>
        <p class="mb-1">@Model.OrganizationName @Model.CustomerName</p>
        <p class="text-muted mb-1">@Model.CustomerPhone @(Model.CustomerEmail is not null ? "· " + Model.CustomerEmail : "")</p>
        <p class="text-muted">Delivery: @Model.DeliveryLocation</p>
        <p class="text-muted">Placed @Model.OrderDate.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</p>
    </div>
</div>

<table class="table bg-white">
    <thead><tr><th>Product</th><th>Qty</th><th>Total</th></tr></thead>
    <tbody>
    @foreach (var line in Model.Lines)
    {
        <tr>
            <td>@line.ProductName</td>
            <td>@line.Quantity</td>
            <td>UGX @line.TotalPrice.ToString("N0")</td>
        </tr>
    }
    </tbody>
    <tfoot>
        <tr><td colspan="2" class="text-end">Subtotal</td><td>UGX @Model.Subtotal.ToString("N0")</td></tr>
        <tr><td colspan="2" class="text-end">Discount</td><td>UGX @Model.Discount.ToString("N0")</td></tr>
        <tr class="fw-bold"><td colspan="2" class="text-end">TOTAL</td><td>UGX @Model.TotalAmount.ToString("N0")</td></tr>
    </tfoot>
</table>

<div class="row">
    <div class="col-md-6">
        <h5>Order Status</h5>
        <p>Current: <span class="badge bg-secondary">@Model.OrderStatus</span></p>
        @if (Model.DispatchedDate is not null) { <p class="text-muted small">Dispatched: @Model.DispatchedDate.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</p> }
        @if (Model.DeliveredDate is not null) { <p class="text-muted small">Delivered: @Model.DeliveredDate.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</p> }

        @if (Model.AvailableNextStatuses.Any())
        {
            <form asp-action="ChangeStatus" asp-route-id="@Model.OrderId" method="post" class="d-flex gap-2 align-items-end flex-wrap"
                  onsubmit="return confirm('Change this order\'s status?');">
                <div>
                    <label class="form-label small">Move to</label>
                    <select name="newStatus" class="form-select form-select-sm">
                        @foreach (var status in Model.AvailableNextStatuses)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
                <div class="flex-grow-1">
                    <label class="form-label small">Notes (e.g. cancellation reason)</label>
                    <input type="text" name="notes" class="form-control form-control-sm" />
                </div>
                <button type="submit" class="btn btn-sm btn-primary">Update Status</button>
            </form>
        }
        else
        {
            <p class="text-muted small">This order is in a final state.</p>
        }
    </div>

    <div class="col-md-6">
        <h5>Payment</h5>
        <p>Status: <span class="badge bg-light text-dark">@Model.PaymentStatus</span> · Paid so far: UGX @Model.AmountPaid.ToString("N0") of UGX @Model.TotalAmount.ToString("N0")</p>

        <form asp-action="UpdatePayment" asp-route-id="@Model.OrderId" method="post" class="d-flex gap-2 align-items-end flex-wrap">
            <div>
                <label class="form-label small">Payment Status</label>
                <select name="paymentStatus" class="form-select form-select-sm">
                    @foreach (var status in Enum.GetValues<MedicalSupplies.Core.Enums.PaymentStatus>())
                    {
                        <option value="@status" selected="@(status == Model.PaymentStatus)">@status</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label small">Amount Paid (UGX)</label>
                <input type="number" step="0.01" name="amountPaid" value="@Model.AmountPaid" class="form-control form-control-sm" style="width:150px;" />
            </div>
            <button type="submit" class="btn btn-sm btn-outline-primary">Save Payment</button>
        </form>
    </div>
</div>

<h5 class="mt-4">Status History</h5>
<table class="table table-sm bg-white">
    <thead><tr><th>When</th><th>Status</th><th>By</th><th>Notes</th></tr></thead>
    <tbody>
    @foreach (var h in Model.StatusHistory)
    {
        <tr>
            <td>@h.ChangedDate.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
            <td><span class="badge bg-secondary">@h.Status</span></td>
            <td>@(h.ChangedBy ?? "—")</td>
            <td>@h.Notes</td>
        </tr>
    }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-link">&larr; Back to Orders</a>
