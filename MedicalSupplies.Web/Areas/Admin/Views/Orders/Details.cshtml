@model OrderDetailsViewModel
@{ ViewData["Title"] = $"Order {Model.OrderNumber}"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Order @Model.OrderNumber</h1>
    <span class="badge bg-secondary fs-6">@Model.OrderStatus</span>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <h5>Customer</h5>

        @if (!string.IsNullOrWhiteSpace(Model.OrganizationName))
        {
            <div class="mb-2">
                <div class="text-muted small">Account / Organization</div>
                <div class="fw-semibold">@Model.OrganizationName</div>
            </div>
        }

        <div class="mb-2">
            <div class="text-muted small">Contact Person</div>
            <div>@Model.CustomerName</div>
        </div>

        <div class="mb-2">
            <div class="text-muted small">Contact</div>
            <div>
                @if (!string.IsNullOrWhiteSpace(Model.CustomerPhone))
                {
                    <span>@Model.CustomerPhone</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.CustomerPhone) && !string.IsNullOrWhiteSpace(Model.CustomerEmail))
                {
                    <span> · </span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
                {
                    <span>@Model.CustomerEmail</span>
                }
            </div>
        </div>

        <div class="mb-2">
            <div class="text-muted small">Delivery</div>
            <div>@Model.DeliveryLocation</div>
        </div>

        <div class="text-muted small">
            Placed @Model.OrderDate.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
        </div>
    </div>
</div>

<table class="table bg-white">
    <thead>
        <tr>
            <th>Product</th>
            <th class="text-end">Qty</th>
            <th class="text-end">Unit Price</th>
            <th class="text-end">Total</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var line in Model.Lines)
    {
        <tr>
            <td>@line.ProductName</td>
            <td class="text-end">@line.Quantity</td>
            <td class="text-end">UGX @line.UnitPrice.ToString("N0")</td>
            <td class="text-end">UGX @line.TotalPrice.ToString("N0")</td>
        </tr>
    }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3" class="text-end">Subtotal</td>
            <td class="text-end">UGX @Model.Subtotal.ToString("N0")</td>
        </tr>
        <tr>
            <td colspan="3" class="text-end">Discount</td>
            <td class="text-end">UGX @Model.Discount.ToString("N0")</td>
        </tr>
        <tr>
            <td colspan="3" class="text-end">Delivery / Transport</td>
            <td class="text-end">UGX @Model.DeliveryCost.ToString("N0")</td>
        </tr>
        <tr class="fw-bold">
            <td colspan="3" class="text-end">TOTAL</td>
            <td class="text-end">UGX @Model.TotalAmount.ToString("N0")</td>
        </tr>
    </tfoot>
</table>

<div class="row">
    <div class="col-md-6">
        <h5>Order Status</h5>
        <p>Current: <span class="badge bg-secondary">@Model.OrderStatus</span></p>
        @if (Model.DispatchedDate is not null) { <p class="text-muted small">Dispatched: @Model.DispatchedDate.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</p> }
        @if (Model.DeliveredDate is not null) { <p class="text-muted small">Delivered: @Model.DeliveredDate.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</p> }

        @if (Model.AvailableNextStatuses.Any())
        {
            <form asp-action="ChangeStatus" asp-route-id="@Model.OrderId" method="post" class="d-flex gap-2 align-items-end flex-wrap"
                  onsubmit="return confirm('Change this order\'s status?');">
                <div>
                    <label class="form-label small">Move to</label>
                    <select name="newStatus" class="form-select form-select-sm">
                        @foreach (var status in Model.AvailableNextStatuses)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
                <div class="flex-grow-1">
                    <label class="form-label small">Notes (e.g. cancellation reason)</label>
                    <input type="text" name="notes" class="form-control form-control-sm" />
                </div>
                <button type="submit" class="btn btn-sm btn-primary">Update Status</button>
            </form>
        }
        else
        {
            <p class="text-muted small">This order is in a final state.</p>
        }
    </div>

    <div class="col-md-6">
        <h5>Payment</h5>
        <div class="mb-3">
            <div class="d-flex justify-content-between">
                <span>Status</span>
                <span class="badge bg-light text-dark">@Model.PaymentStatus</span>
            </div>
            <div class="d-flex justify-content-between">
                <span>Total</span>
                <strong>UGX @Model.TotalAmount.ToString("N0")</strong>
            </div>
            <div class="d-flex justify-content-between">
                <span>Paid</span>
                <strong>UGX @Model.AmountPaid.ToString("N0")</strong>
            </div>
            <div class="d-flex justify-content-between border-top mt-2 pt-2">
                <span>Balance</span>
                <strong>UGX @Model.Balance.ToString("N0")</strong>
            </div>
        </div>

        <form asp-action="UpdatePayment" asp-route-id="@Model.OrderId" method="post" class="d-flex gap-2 align-items-end flex-wrap">
            <div>
                <label class="form-label small">Payment Status</label>
                <select name="paymentStatus" class="form-select form-select-sm">
                    @foreach (var status in Enum.GetValues<MedicalSupplies.Core.Enums.PaymentStatus>())
                    {
                        <option value="@status" selected="@(status == Model.PaymentStatus)">@status</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label small">Amount Paid (UGX)</label>
                <input type="number" step="0.01" name="amountPaid" value="@Model.AmountPaid" class="form-control form-control-sm" style="width:150px;" />
            </div>
            <button type="submit" class="btn btn-sm btn-outline-primary">Save Payment</button>
        </form>
    </div>
</div>

<h5 class="mt-4">Status History</h5>
<table class="table table-sm bg-white">
    <thead><tr><th>When</th><th>Status</th><th>By</th><th>Notes</th></tr></thead>
    <tbody>
    @foreach (var h in Model.StatusHistory)
    {
        <tr>
            <td>@h.ChangedDate.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
            <td><span class="badge bg-secondary">@h.Status</span></td>
            <td>@(h.ChangedBy ?? "—")</td>
            <td>@h.Notes</td>
        </tr>
    }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-link">&larr; Back to Orders</a>
