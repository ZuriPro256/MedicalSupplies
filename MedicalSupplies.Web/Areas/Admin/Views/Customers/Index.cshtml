@model List<MedicalSupplies.Web.ViewModels.Admin.Customers.CustomerListItemViewModel>

@{
    ViewData["Title"] = "Customers";
    var search = ViewBag.Search as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">Customers</h1>
        <p class="text-muted mb-0">Manage customer accounts, organizations and contact information.</p>
    </div>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-6">
        <input type="text"
               name="search"
               value="@search"
               class="form-control"
               placeholder="Search organization, name, email or phone..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(search))
    {
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    }
</form>

<div class="table-responsive">
    <table class="table table-hover bg-white align-middle">
        <thead>
            <tr>
                <th>Organization / Account</th>
                <th>Contact Person</th>
                <th>Contact</th>
                <th>Type</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var customer in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrWhiteSpace(customer.OrganizationName))
                    {
                        <strong>@customer.OrganizationName</strong>
                    }
                    else
                    {
                        <span class="text-muted">Individual</span>
                    }
                </td>
                <td>@customer.CustomerName</td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(customer.Phone))
                    {
                        <div>@customer.Phone</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(customer.Email))
                    {
                        <div class="small text-muted">@customer.Email</div>
                    }
                </td>
                <td>@customer.CustomerType</td>
                <td>
                    @if (customer.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td class="text-end">
                    <a asp-action="Details"
                       asp-route-id="@customer.CustomerId"
                       class="btn btn-sm btn-outline-primary">View</a>
                    <a asp-action="Edit"
                       asp-route-id="@customer.CustomerId"
                       class="btn btn-sm btn-outline-secondary">Edit</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-light border">
        No customers found.
    </div>
}
